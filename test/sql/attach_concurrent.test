# name: test/sql/attach_concurrent.test
# description: Phase 1 WP5: concurrent scenario writers surface as normal transaction/constraint conflicts
# group: [anofox_scenario]

require anofox_scenario

statement ok
CREATE TABLE forecast (id INTEGER PRIMARY KEY, qty INTEGER);

statement ok
INSERT INTO forecast VALUES (1, 100), (2, 200);

statement ok
CALL scenario_create('cc');

statement ok
ATTACH 'cc' AS s (TYPE scenario);

# the table's first write creates its delta (#34); commit one up front, so the
# two writers below race on the delta's rows rather than on creating it (that
# race is covered in attach_lazy_delta.test)
statement ok
UPDATE s.forecast SET qty = 200 WHERE id = 2;

# two connections updating the SAME base row in the same scenario:
# both write a 'U' delta row for PK 1; the second commit must fail on the
# delta's PK index (normal DuckDB conflict semantics, no silent last-wins)

statement ok con1
BEGIN;

statement ok con1
UPDATE s.forecast SET qty = 111 WHERE id = 1;

statement ok con2
BEGIN;

statement ok con2
UPDATE s.forecast SET qty = 222 WHERE id = 1;

statement ok con1
COMMIT;

statement error con2
COMMIT;
----
<REGEX>:.*(conflict|Conflict|constraint|PRIMARY KEY).*

# the first writer's change won; the scenario is consistent
query I
SELECT qty FROM s.forecast WHERE id = 1;
----
111

# independent rows from two connections coexist fine
statement ok con1
UPDATE s.forecast SET qty = 201 WHERE id = 2;

statement ok con2
INSERT INTO s.forecast VALUES (3, 300);

query II
SELECT id, qty FROM s.forecast ORDER BY id;
----
1	111
2	201
3	300

statement ok
DETACH s;

statement ok
CALL scenario_drop('cc');

# ---------------------------------------------------------------------------
# #39 F0: an older snapshot keeps reading its own version of the delta after
# another connection commits changes to the same scenario keys. Every delta
# change deletes the old delta row and appends a new one; DuckDB moves the
# committed-but-still-visible old row id out of the main PK index (into
# deleted_rows_in_use), so the delta key probe must look there as well.
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE snap (id INTEGER PRIMARY KEY, qty INTEGER);

statement ok
INSERT INTO snap VALUES (1, 100), (2, 200), (3, 300), (4, 400);

statement ok
CALL scenario_create('snapshots');

statement ok
ATTACH 'snapshots' AS sn (TYPE scenario);

statement ok
UPDATE sn.snap SET qty = 111 WHERE id = 1;

statement ok
DELETE FROM sn.snap WHERE id = 2;

# --- reads from the older snapshot ---------------------------------------

statement ok con1
BEGIN;

query II con1
SELECT * FROM sn.snap ORDER BY ALL;
----
1	111
3	300
4	400

statement ok con2
UPDATE sn.snap SET qty = 999 WHERE id = 1;

statement ok con2
INSERT INTO sn.snap VALUES (2, 222);

# con1 still sees its snapshot: no base row resurfaces, no key twice
query II con1
SELECT * FROM sn.snap ORDER BY ALL;
----
1	111
3	300
4	400

query I con1
SELECT qty FROM sn.snap WHERE id = 1;
----
111

query I con1
SELECT count(*) FROM sn.snap WHERE id = 2;
----
0

query II con2
SELECT * FROM sn.snap ORDER BY ALL;
----
1	999
2	222
3	300
4	400

statement ok con1
COMMIT;

# --- writes from the older snapshot --------------------------------------

statement ok con1
BEGIN;

query I con1
SELECT count(*) FROM sn.snap;
----
4

statement ok con2
UPDATE sn.snap SET qty = 1000 WHERE id = 1;

statement ok con2
DELETE FROM sn.snap WHERE id = 2;

# an untouched key is still writable, and the merged view stays the snapshot
statement ok con1
UPDATE sn.snap SET qty = qty + 1 WHERE id = 3;

query II con1
SELECT * FROM sn.snap ORDER BY ALL;
----
1	999
2	222
3	301
4	400

# key 1 was changed by the committed transaction: a write-write conflict,
# never a second 'I' row or a resurrected base row
statement error con1
UPDATE sn.snap SET qty = 5 WHERE id = 1;
----
<REGEX>:.*(Conflict|conflict).*

statement ok con1
ROLLBACK;

statement ok con1
BEGIN;

query I con1
SELECT count(*) FROM sn.snap;
----
3

statement ok con2
UPDATE sn.snap SET qty = 1000 WHERE id = 1;

statement ok con2
INSERT INTO sn.snap VALUES (2, 333);

query I con1
SELECT count(*) FROM sn.snap WHERE id = 2;
----
0

statement error con1
DELETE FROM sn.snap WHERE id = 1;
----
<REGEX>:.*(Conflict|conflict).*

statement ok con1
ROLLBACK;

statement ok con1
BEGIN;

query I con1
SELECT count(*) FROM sn.snap;
----
4

statement ok con2
DELETE FROM sn.snap WHERE id = 2;

# key 2 is still live in con1's snapshot: re-inserting it is a duplicate
statement error con1
INSERT INTO sn.snap VALUES (2, 444);
----
<REGEX>:.*(already inserted or modified in this scenario|Conflict|conflict).*

statement ok con1
ROLLBACK;

query II
SELECT * FROM sn.snap ORDER BY ALL;
----
1	1000
3	300
4	400

statement ok
DETACH sn;

statement ok
CALL scenario_drop('snapshots');

statement ok
ATTACH 'legacy_child' AS c (TYPE scenario);

query I
SELECT count(*) FROM (
    (SELECT * FROM c.web_events EXCEPT ALL SELECT * FROM s.web_events)
    UNION ALL
    (SELECT * FROM s.web_events EXCEPT ALL SELECT * FROM c.web_events));
----
0

query I
DELETE FROM c.web_events WHERE session_id = 5;
----
2

query I
SELECT count(*) FROM s.web_events WHERE session_id = 5;
----
2

statement ok
DETACH c;


# --- large generated variant: 150k legacy rows over a 60k-row base --------------------------

statement ok
CREATE TABLE big_events AS
SELECT (i % 5000)::INTEGER AS session_id,
       CASE WHEN i % 11 = 0 THEN NULL ELSE '/p/' || (i % 97) END AS url,
       TIMESTAMP '2026-07-01 00:00:00' + to_seconds(i % 3600) AS ts,
       CASE WHEN i % 3 = 0 THEN NULL ELSE 'ref' || (i % 7) END AS referrer
FROM range(60000) t(i);

statement ok
CALL scenario_create('legacy_big');

query I
SELECT scenario_id FROM scenario_list() WHERE name = 'legacy_big';
----
7

statement ok
DROP TABLE __anofox_scenario.s7_delta_big_events;

statement ok
CREATE TABLE __anofox_scenario.s7_delta_big_events (_op VARCHAR NOT NULL, _ts TIMESTAMP NOT NULL,
    session_id INTEGER, url VARCHAR, ts TIMESTAMP, referrer VARCHAR);

# 150k old inserts, heavily duplicated (and overlapping base values)
statement ok
INSERT INTO __anofox_scenario.s7_delta_big_events
SELECT 'I', TIMESTAMP '2026-06-01 08:00:00',
       (i % 7000)::INTEGER,
       CASE WHEN i % 13 = 0 THEN NULL ELSE '/p/' || (i % 97) END,
       TIMESTAMP '2026-07-01 00:00:00' + to_seconds(i % 3600),
       CASE WHEN i % 5 = 0 THEN NULL ELSE 'ref' || (i % 7) END
FROM range(150000) t(i);

# the expected merged relation, maintained alongside as a plain table
statement ok
CREATE TABLE big_expected AS
SELECT * FROM big_events
UNION ALL
SELECT session_id, url, ts, referrer FROM __anofox_scenario.s7_delta_big_events;

statement ok
ATTACH 'legacy_big' AS b (TYPE scenario);

query II
SELECT count(*), min(_count) = max(_count) AND min(_count) = 1 FROM __anofox_scenario.s7_delta_big_events;
----
150000	true

query I
SELECT count(*) FROM b.big_events;
----
210000

query I
SELECT count(*) FROM (
    (SELECT * FROM b.big_events EXCEPT ALL SELECT * FROM big_expected)
    UNION ALL
    (SELECT * FROM big_expected EXCEPT ALL SELECT * FROM b.big_events));
----
0

# the same DML on both sides keeps them equal
statement ok
DELETE FROM b.big_events WHERE session_id % 17 = 0;

statement ok
DELETE FROM big_expected WHERE session_id % 17 = 0;

statement ok
UPDATE b.big_events SET referrer = 'rewritten' WHERE session_id % 101 = 3 AND referrer IS NULL;

statement ok
UPDATE big_expected SET referrer = 'rewritten' WHERE session_id % 101 = 3 AND referrer IS NULL;

statement ok
INSERT INTO b.big_events SELECT (i % 50)::INTEGER, '/new', NULL, NULL FROM range(1000) t(i);

statement ok
INSERT INTO big_expected SELECT (i % 50)::INTEGER, '/new', NULL, NULL FROM range(1000) t(i);

query I
SELECT count(*) FROM (
    (SELECT * FROM b.big_events EXCEPT ALL SELECT * FROM big_expected)
    UNION ALL
    (SELECT * FROM big_expected EXCEPT ALL SELECT * FROM b.big_events));
----
0

# the diff accounts for every row the scenario adds or removes
query I
SELECT (SELECT count(*) FROM big_events) + sum(CASE WHEN change_type = 'added' THEN 1 ELSE -1 END) = (SELECT count(*) FROM big_expected)
FROM scenario_diff('legacy_big', 'big_events');
----
true

statement ok
DETACH b;

query I
SELECT rows_applied > 0 FROM scenario_merge('legacy_big');
----
true

query I
SELECT count(*) FROM (
    (SELECT * FROM big_events EXCEPT ALL SELECT * FROM big_expected)
    UNION ALL
    (SELECT * FROM big_expected EXCEPT ALL SELECT * FROM big_events));
----
0

# --- ATTACH inside a transaction that already wrote another database ------------------------

statement ok
CALL scenario_create('legacy_txn');

query I
SELECT scenario_id FROM scenario_list() WHERE name = 'legacy_txn';
----
8

statement ok
DROP TABLE __anofox_scenario.s8_delta_clicks;

statement ok
CREATE TABLE __anofox_scenario.s8_delta_clicks (_op VARCHAR NOT NULL, _ts TIMESTAMP NOT NULL,
    page VARCHAR, campaign VARCHAR);

statement ok
INSERT INTO __anofox_scenario.s8_delta_clicks VALUES ('I', TIMESTAMP '2026-06-01 08:00:00', '/txn', NULL);

statement ok
ATTACH '__TEST_DIR__/keyless_upgrade_other.db' AS other;

statement ok
CREATE TABLE other.audit (note VARCHAR);

statement ok
BEGIN;

statement ok
INSERT INTO other.audit VALUES ('busy');

# single-writer rule: the upgrade cannot write the host here, so it is skipped...
statement ok
ATTACH 'legacy_txn' AS t (TYPE scenario);

# ...and reads still see every legacy row
query I
SELECT count(*) FROM t.clicks WHERE page = '/txn';
----
1

statement ok
COMMIT;

query I
SELECT count(*) FROM duckdb_columns() WHERE schema_name = '__anofox_scenario' AND table_name = 's8_delta_clicks' AND column_name = '_count';
----
0

statement error
DELETE FROM t.clicks WHERE page = '/txn';
----
re-ATTACH

# a plain re-ATTACH upgrades and unlocks keyless DML
statement ok
DETACH t;

statement ok
ATTACH 'legacy_txn' AS t (TYPE scenario);

query I
DELETE FROM t.clicks WHERE page = '/txn';
----
1

query I
SELECT count(*) FROM t.clicks WHERE page = '/txn';
----
0

statement ok
DETACH t;

statement ok
DETACH other;

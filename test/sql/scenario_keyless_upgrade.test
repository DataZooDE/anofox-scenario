# name: test/sql/scenario_keyless_upgrade.test
# description: keyless deltas written before v0.4.1 (no _count column) are upgraded in place (#31)
# group: [anofox_scenario]

require anofox_scenario

load __TEST_DIR__/keyless_upgrade.db

# A pre-v0.4.1 keyless delta was s<id>_delta_<t>(_op, _ts, <base columns>):
# no PRIMARY KEY, no trailing _count, the base's secondary UNIQUE constraints
# mirrored, and only 'I' rows (UPDATE/DELETE on keyless tables were gated, so
# every row is one inserted copy). The tests below fabricate exactly that
# layout by hand and check that old scenarios get full keyless support.

statement ok
CREATE TABLE web_events (session_id INTEGER, url VARCHAR, ts TIMESTAMP, referrer VARCHAR);

# duplicates and NULLs are meaningful in a bag
statement ok
INSERT INTO web_events VALUES
    (1, '/home',    TIMESTAMP '2026-07-01 10:00:00', 'google'),
    (1, '/home',    TIMESTAMP '2026-07-01 10:00:00', 'google'),
    (2, '/pricing', TIMESTAMP '2026-07-01 10:05:00', NULL),
    (3, NULL,       TIMESTAMP '2026-07-01 10:07:00', NULL),
    (4, '/docs',    TIMESTAMP '2026-07-01 11:00:00', 'twitter');

# keyless, but with a secondary UNIQUE (old deltas mirrored it)
statement ok
CREATE TABLE devices (serial VARCHAR UNIQUE, owner VARCHAR);

statement ok
INSERT INTO devices VALUES ('SN-1', 'alice'), ('SN-2', 'bob');

statement ok
CALL scenario_create('legacy', 'written by v0.4.0');

statement ok
CALL scenario_create('legacy_parent', 'branched without attaching');

statement ok
CALL scenario_create('legacy_frozen', 'frozen before the upgrade');

query IT
SELECT scenario_id, name FROM scenario_list() ORDER BY scenario_id;
----
1	legacy
2	legacy_parent
3	legacy_frozen

# --- fabricate the pre-v0.4.1 layout for scenarios 1..3 --------------------------------

statement ok
DROP TABLE __anofox_scenario.s1_delta_web_events;

statement ok
CREATE TABLE __anofox_scenario.s1_delta_web_events (_op VARCHAR NOT NULL, _ts TIMESTAMP NOT NULL,
    session_id INTEGER, url VARCHAR, ts TIMESTAMP, referrer VARCHAR);

statement ok
INSERT INTO __anofox_scenario.s1_delta_web_events VALUES
    ('I', TIMESTAMP '2026-06-01 08:00:00', 5, '/signup',  TIMESTAMP '2026-07-02 09:00:00', 'newsletter'),
    ('I', TIMESTAMP '2026-06-01 08:00:00', 5, '/signup',  TIMESTAMP '2026-07-02 09:00:00', 'newsletter'),
    ('I', TIMESTAMP '2026-06-01 08:00:00', 1, '/home',    TIMESTAMP '2026-07-01 10:00:00', 'google'),
    ('I', TIMESTAMP '2026-06-01 08:00:00', 6, NULL,       NULL,                            NULL),
    ('I', TIMESTAMP '2026-06-01 08:00:00', 2, '/pricing', TIMESTAMP '2026-07-01 10:05:00', NULL);

statement ok
DROP TABLE __anofox_scenario.s1_delta_devices;

statement ok
CREATE TABLE __anofox_scenario.s1_delta_devices (_op VARCHAR NOT NULL, _ts TIMESTAMP NOT NULL,
    serial VARCHAR, owner VARCHAR, UNIQUE (serial));

statement ok
INSERT INTO __anofox_scenario.s1_delta_devices VALUES
    ('I', TIMESTAMP '2026-06-01 08:00:00', 'SN-3', 'carol'),
    ('I', TIMESTAMP '2026-06-01 08:00:00', NULL,   'dave'),
    ('I', TIMESTAMP '2026-06-01 08:00:00', NULL,   'erin');

statement ok
DROP TABLE __anofox_scenario.s2_delta_web_events;

statement ok
CREATE TABLE __anofox_scenario.s2_delta_web_events (_op VARCHAR NOT NULL, _ts TIMESTAMP NOT NULL,
    session_id INTEGER, url VARCHAR, ts TIMESTAMP, referrer VARCHAR);

statement ok
INSERT INTO __anofox_scenario.s2_delta_web_events VALUES
    ('I', TIMESTAMP '2026-06-01 08:00:00', 8, '/cart', TIMESTAMP '2026-07-03 12:00:00', 'ads'),
    ('I', TIMESTAMP '2026-06-01 08:00:00', 8, '/cart', TIMESTAMP '2026-07-03 12:00:00', 'ads');

statement ok
DROP TABLE __anofox_scenario.s3_delta_web_events;

statement ok
CREATE TABLE __anofox_scenario.s3_delta_web_events (_op VARCHAR NOT NULL, _ts TIMESTAMP NOT NULL,
    session_id INTEGER, url VARCHAR, ts TIMESTAMP, referrer VARCHAR);

statement ok
INSERT INTO __anofox_scenario.s3_delta_web_events VALUES
    ('I', TIMESTAMP '2026-06-01 08:00:00', 9, '/faq', NULL, NULL);

statement ok
CALL scenario_freeze('legacy_frozen');

# --- read paths work on the legacy layout before anything upgrades it ------------------

# scenario_diff never attaches: old rows count once each
query ITTT rowsort
SELECT session_id, url, referrer, change_type FROM scenario_diff('legacy', 'web_events');
----
1	/home	google	added
2	/pricing	NULL	added
5	/signup	newsletter	added
5	/signup	newsletter	added
6	NULL	NULL	added

query ITTT rowsort
SELECT session_id, url, referrer, change_type FROM scenario_diff('main', 'legacy', 'web_events');
----
1	/home	google	added
2	/pricing	NULL	added
5	/signup	newsletter	added
5	/signup	newsletter	added
6	NULL	NULL	added

query TIII rowsort
SELECT table_name, rows_added, rows_modified, rows_removed FROM scenario_diff_summary('legacy');
----
devices	3	0	0
web_events	5	0	0

# still legacy: nothing above wrote anything
query I
SELECT count(*) FROM duckdb_columns() WHERE schema_name = '__anofox_scenario' AND table_name = 's1_delta_web_events' AND column_name = '_count';
----
0

# --- ATTACH upgrades the scenario's keyless deltas in place -----------------------------

statement ok
ATTACH 'legacy' AS s (TYPE scenario);

# _count is the trailing column, every old row carries multiplicity 1
query T
SELECT column_name FROM duckdb_columns() WHERE schema_name = '__anofox_scenario' AND table_name = 's1_delta_web_events' ORDER BY column_index DESC LIMIT 1;
----
_count

query TII
SELECT _op, _count, count(*) FROM __anofox_scenario.s1_delta_web_events GROUP BY ALL;
----
I	1	5

# old timestamps are preserved
query I
SELECT count(*) FROM __anofox_scenario.s1_delta_web_events WHERE _ts = TIMESTAMP '2026-06-01 08:00:00';
----
5

# the mirrored secondary UNIQUE is gone (bag deltas hold D rows next to I rows)
query I
SELECT count(*) FROM duckdb_constraints() WHERE schema_name = '__anofox_scenario' AND table_name = 's1_delta_devices' AND constraint_type = 'UNIQUE';
----
0

query T
SELECT column_name FROM duckdb_columns() WHERE schema_name = '__anofox_scenario' AND table_name = 's1_delta_devices' ORDER BY column_index DESC LIMIT 1;
----
_count

# merged view = base + every old row, as a bag
query I
SELECT count(*) FROM (
    (SELECT * FROM s.web_events
     EXCEPT ALL
     (SELECT * FROM web_events UNION ALL VALUES
        (5, '/signup',  TIMESTAMP '2026-07-02 09:00:00', 'newsletter'),
        (5, '/signup',  TIMESTAMP '2026-07-02 09:00:00', 'newsletter'),
        (1, '/home',    TIMESTAMP '2026-07-01 10:00:00', 'google'),
        (6, NULL,       NULL,                            NULL),
        (2, '/pricing', TIMESTAMP '2026-07-01 10:05:00', NULL)))
    UNION ALL
    ((SELECT * FROM web_events UNION ALL VALUES
        (5, '/signup',  TIMESTAMP '2026-07-02 09:00:00', 'newsletter'),
        (5, '/signup',  TIMESTAMP '2026-07-02 09:00:00', 'newsletter'),
        (1, '/home',    TIMESTAMP '2026-07-01 10:00:00', 'google'),
        (6, NULL,       NULL,                            NULL),
        (2, '/pricing', TIMESTAMP '2026-07-01 10:05:00', NULL))
     EXCEPT ALL
     SELECT * FROM s.web_events));
----
0

query I
SELECT count(*) FROM s.web_events;
----
10

# --- full keyless DML on the upgraded scenario ------------------------------------------

# DELETE removes base copies and legacy copies alike
query I
DELETE FROM s.web_events WHERE session_id = 1;
----
3

query I
UPDATE s.web_events SET referrer = 'direct' WHERE session_id = 2 AND referrer IS NULL;
----
2

statement ok
INSERT INTO s.web_events VALUES (7, '/blog', TIMESTAMP '2026-07-04 08:30:00', NULL);

query ITTT rowsort
SELECT session_id, url, ts, referrer FROM s.web_events;
----
2	/pricing	2026-07-01 10:05:00	direct
2	/pricing	2026-07-01 10:05:00	direct
3	NULL	2026-07-01 10:07:00	NULL
4	/docs	2026-07-01 11:00:00	twitter
5	/signup	2026-07-02 09:00:00	newsletter
5	/signup	2026-07-02 09:00:00	newsletter
6	NULL	NULL	NULL
7	/blog	2026-07-04 08:30:00	NULL

# base untouched
query I
SELECT count(*) FROM web_events;
----
5

# UPDATE on the formerly UNIQUE-mirrored delta (D + I of the same serial)
query I
UPDATE s.devices SET owner = 'carla' WHERE serial = 'SN-3';
----
1

query I
DELETE FROM s.devices WHERE owner = 'dave';
----
1

query TT rowsort
SELECT serial, owner FROM s.devices;
----
NULL	erin
SN-1	alice
SN-2	bob
SN-3	carla

# UNIQUE is still enforced against the merged relation
statement error
INSERT INTO s.devices VALUES ('SN-3', 'mallory');
----
<REGEX>:.*(unique|UNIQUE|Duplicate|constraint).*

statement error
INSERT INTO s.devices VALUES ('SN-1', 'mallory');
----
<REGEX>:.*(unique|UNIQUE|Duplicate|constraint).*


# --- branching from the upgraded scenario -----------------------------------------------

statement ok
CALL scenario_create('legacy_child', from_scenario := 'legacy');

statement ok
ATTACH 'legacy_child' AS c (TYPE scenario);

query I
SELECT count(*) FROM (
    (SELECT * FROM c.web_events EXCEPT ALL SELECT * FROM s.web_events)
    UNION ALL
    (SELECT * FROM s.web_events EXCEPT ALL SELECT * FROM c.web_events));
----
0

query I
DELETE FROM c.web_events WHERE session_id = 5;
----
2

query I
SELECT count(*) FROM s.web_events WHERE session_id = 5;
----
2

statement ok
DETACH c;

# --- branching from a legacy parent that was never attached ------------------------------

statement ok
CALL scenario_create('legacy_parent_child', from_scenario := 'legacy_parent');

# branching never rewrites the parent (a concurrent writer of the parent would
# lose its commit): the parent keeps its legacy layout...
query I
SELECT count(*) FROM duckdb_columns() WHERE schema_name = '__anofox_scenario' AND table_name = 's2_delta_web_events' AND column_name = '_count';
----
0

# ...and the child gets the parent's rows in the bag layout, one copy each
query TII
SELECT d._op, d._count, count(*) FROM __anofox_scenario.s5_delta_web_events d GROUP BY ALL;
----
I	1	2

statement ok
ATTACH 'legacy_parent_child' AS pc (TYPE scenario);

query I
SELECT count(*) FROM pc.web_events WHERE session_id = 8;
----
2

query I
UPDATE pc.web_events SET referrer = 'organic' WHERE session_id = 8;
----
2

query IT rowsort
SELECT session_id, referrer FROM pc.web_events WHERE session_id = 8;
----
8	organic
8	organic

statement ok
DETACH pc;

statement ok
ATTACH 'legacy_parent' AS p (TYPE scenario);

query IT rowsort
SELECT session_id, referrer FROM p.web_events WHERE session_id = 8;
----
8	ads
8	ads

statement ok
DETACH p;


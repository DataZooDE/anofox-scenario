# name: test/sql/attach_mixed_txn.test
# description: host writes and scenario writes in the same explicit transaction (#31)
# group: [anofox_scenario]

require anofox_scenario

statement ok
CREATE TABLE orders (order_id INTEGER PRIMARY KEY, customer VARCHAR NOT NULL, amount DECIMAL(10,2), status VARCHAR);

statement ok
CREATE TABLE order_audit (audit_id INTEGER PRIMARY KEY, order_id INTEGER, action VARCHAR, note VARCHAR);

statement ok
INSERT INTO orders VALUES
    (1, 'acme',    120.00, 'open'),
    (2, 'globex',  80.50,  'open'),
    (3, 'initech', 300.00, 'shipped');

statement ok
CALL scenario_create('whatif', 'discount what-if');

statement ok
ATTACH 'whatif' AS s (TYPE scenario);

# --- host first, then scenario: COMMIT keeps both -----------------------------

statement ok
BEGIN;

statement ok
INSERT INTO orders VALUES (4, 'umbrella', 55.00, 'open');

statement ok
INSERT INTO order_audit VALUES (1, 4, 'create', 'host order');

statement ok
UPDATE s.orders SET amount = amount * 0.9 WHERE status = 'open';

statement ok
INSERT INTO s.order_audit VALUES (100, 1, 'discount', 'scenario 10% off');

# read-your-writes inside the transaction: the host insert is visible through
# the scenario (delta mode reads the live base), the scenario edit is not in
# the host
query IR
SELECT order_id, amount FROM s.orders ORDER BY order_id;
----
1	108.00
2	72.45
3	300.00
4	49.50

query IR
SELECT order_id, amount FROM orders ORDER BY order_id;
----
1	120.00
2	80.50
3	300.00
4	55.00

statement ok
COMMIT;

query IR
SELECT order_id, amount FROM s.orders ORDER BY order_id;
----
1	108.00
2	72.45
3	300.00
4	49.50

query IR
SELECT order_id, amount FROM orders ORDER BY order_id;
----
1	120.00
2	80.50
3	300.00
4	55.00

query IT
SELECT audit_id, note FROM order_audit ORDER BY audit_id;
----
1	host order

query IT
SELECT audit_id, note FROM s.order_audit ORDER BY audit_id;
----
1	host order
100	scenario 10% off

# --- scenario first, then host: COMMIT keeps both -----------------------------

statement ok
BEGIN;

statement ok
DELETE FROM s.orders WHERE order_id = 3;

statement ok
INSERT INTO orders VALUES (5, 'hooli', 999.99, 'open');

statement ok
UPDATE orders SET status = 'shipped' WHERE order_id = 1;

statement ok
INSERT INTO s.order_audit VALUES (101, 3, 'cancel', 'scenario cancels 3');

statement ok
COMMIT;

# order 1 carries a scenario update ('U' delta row), which shadows the base
# row: the host's status change is not visible through the scenario
query ITR
SELECT order_id, status, amount FROM s.orders ORDER BY order_id;
----
1	open	108.00
2	open	72.45
4	open	49.50
5	open	999.99

query IT
SELECT order_id, status FROM orders ORDER BY order_id;
----
1	shipped
2	open
3	shipped
4	open
5	open

# --- ROLLBACK undoes both sides, in either order -------------------------------

statement ok
BEGIN;

statement ok
INSERT INTO s.orders VALUES (50, 'scenario-only', 1.00, 'open');

statement ok
INSERT INTO orders VALUES (6, 'stark', 10.00, 'open');

statement ok
INSERT INTO s.order_audit VALUES (102, 50, 'create', 'rolled back');

statement ok
INSERT INTO order_audit VALUES (2, 6, 'create', 'rolled back');

statement ok
ROLLBACK;

query I
SELECT count(*) FROM orders WHERE order_id = 6;
----
0

query I
SELECT count(*) FROM order_audit WHERE audit_id = 2;
----
0

query I
SELECT count(*) FROM s.orders WHERE order_id IN (6, 50);
----
0

query I
SELECT count(*) FROM s.order_audit WHERE audit_id = 102;
----
0

# a failing statement aborts the transaction; ROLLBACK discards both sides
statement ok
BEGIN;

statement ok
INSERT INTO orders VALUES (7, 'wayne', 70.00, 'open');

statement ok
UPDATE s.orders SET amount = 0 WHERE order_id = 2;

statement error
INSERT INTO s.orders VALUES (1, 'dup', 1.00, 'open');
----
<REGEX>:.*(Constraint|PRIMARY KEY|duplicate).*

statement ok
ROLLBACK;

query I
SELECT count(*) FROM orders WHERE order_id = 7;
----
0

query R
SELECT amount FROM s.orders WHERE order_id = 2;
----
72.45

# --- two scenarios written in one transaction (both land in the host) ----------

statement ok
CALL scenario_create('pessimistic');

statement ok
ATTACH 'pessimistic' AS p (TYPE scenario);

statement ok
BEGIN;

statement ok
UPDATE s.orders SET status = 'won' WHERE order_id = 2;

statement ok
UPDATE p.orders SET status = 'lost' WHERE order_id = 2;

statement ok
INSERT INTO order_audit VALUES (3, 2, 'review', 'both scenarios updated');

statement ok
COMMIT;

query TTT
SELECT (SELECT status FROM orders WHERE order_id = 2),
       (SELECT status FROM s.orders WHERE order_id = 2),
       (SELECT status FROM p.orders WHERE order_id = 2);
----
open	won	lost

# --- a genuinely different database is still subject to the single-writer rule --

statement ok
ATTACH ':memory:' AS other;

statement ok
CREATE TABLE other.ledger (id INTEGER);

statement ok
BEGIN;

statement ok
INSERT INTO other.ledger VALUES (1);

statement error
INSERT INTO s.orders VALUES (60, 'x', 1.00, 'open');
----
<REGEX>:.*single transaction can only write to a single attached database.*

statement ok
ROLLBACK;

statement ok
BEGIN;

statement ok
INSERT INTO s.orders VALUES (60, 'x', 1.00, 'open');

statement error
INSERT INTO other.ledger VALUES (1);
----
<REGEX>:.*single transaction can only write to a single attached database.*

statement ok
ROLLBACK;

query I
SELECT count(*) FROM s.orders WHERE order_id = 60;
----
0

statement ok
DETACH other;

# --- read-only transactions still refuse scenario writes, up front -------------

statement ok
BEGIN TRANSACTION READ ONLY;

statement error
INSERT INTO s.orders VALUES (61, 'ro', 1.00, 'open');
----
<REGEX>:.*read-only.*

statement ok
ROLLBACK;

# zero-row writes too: the check runs when the sink initializes, not at the first written row
statement ok
BEGIN TRANSACTION READ ONLY;

statement error
UPDATE s.orders SET amount = 0 WHERE order_id = -1;
----
<REGEX>:.*read-only mode.*

statement ok
ROLLBACK;

# the check runs at EXECUTE, so it follows the transaction the statement
# executes in
statement ok
PREPARE zero_update AS UPDATE s.orders SET amount = 0 WHERE order_id = -1;

statement ok
EXECUTE zero_update;

statement ok
BEGIN TRANSACTION READ ONLY;

statement error
EXECUTE zero_update;
----
<REGEX>:.*read-only mode.*

statement ok
ROLLBACK;

statement ok
DEALLOCATE zero_update;

# --- a scenario attached READ_ONLY refuses writes up front ----------------------

statement ok
ATTACH 'whatif' AS ro (TYPE scenario, READ_ONLY);

statement error
INSERT INTO ro.orders VALUES (62, 'ro', 1.00, 'open');
----
<REGEX>:.*attached in read-only mode.*

statement error
UPDATE ro.orders SET amount = 0 WHERE order_id = 1;
----
<REGEX>:.*attached in read-only mode.*

# zero-row statements fail as well
statement error
UPDATE ro.orders SET amount = 0 WHERE order_id = -1;
----
<REGEX>:.*attached in read-only mode.*

statement error
DELETE FROM ro.orders WHERE order_id = -1;
----
<REGEX>:.*attached in read-only mode.*

statement error
INSERT INTO ro.orders SELECT * FROM orders WHERE order_id = -1;
----
<REGEX>:.*attached in read-only mode.*

statement error
MERGE INTO ro.orders USING (SELECT -1 AS order_id) src ON ro.orders.order_id = src.order_id
WHEN MATCHED THEN DELETE;
----
<REGEX>:.*attached in read-only mode.*

# reads keep working
query I
SELECT count(*) FROM ro.orders;
----
4

statement ok
DETACH ro;

# --- introspection: scenario tables are plain base tables -----------------------
# (the binder sees a temporary-flagged entry so it does not name the scenario
# database as the write target; enumeration hands out a non-temporary one)

query TTT
SELECT database_name, temporary, sql FROM duckdb_tables() WHERE table_name = 'orders' ORDER BY database_name;
----
memory	false	CREATE TABLE orders(order_id INTEGER PRIMARY KEY, customer VARCHAR NOT NULL, amount DECIMAL(10,2), status VARCHAR);
p	false	CREATE TABLE orders(order_id INTEGER PRIMARY KEY, customer VARCHAR NOT NULL, amount DECIMAL(10,2), status VARCHAR);
s	false	CREATE TABLE orders(order_id INTEGER PRIMARY KEY, customer VARCHAR NOT NULL, amount DECIMAL(10,2), status VARCHAR);

query TTTT
SELECT table_catalog, table_name, table_type, commit_action FROM information_schema.tables
WHERE table_catalog IN ('s', 'p') ORDER BY table_catalog, table_name;
----
p	order_audit	BASE TABLE	NULL
p	orders	BASE TABLE	NULL
s	order_audit	BASE TABLE	NULL
s	orders	BASE TABLE	NULL

query TTT
SELECT database, name, temporary FROM (SHOW ALL TABLES) WHERE database = 's' ORDER BY name;
----
s	order_audit	false
s	orders	false

query T
SELECT name FROM (SHOW TABLES FROM s) ORDER BY name;
----
order_audit
orders

query II
SELECT count(*), count(*) FILTER (WHERE column_name = 'amount') FROM duckdb_columns() WHERE database_name = 's' AND table_name = 'orders';
----
4	1

# introspection and mixed writes in one transaction: the enumerated entries and
# the bound entries coexist in the per-transaction cache
statement ok
BEGIN;

query T
SELECT table_type FROM information_schema.tables WHERE table_catalog = 's' AND table_name = 'orders';
----
BASE TABLE

statement ok
INSERT INTO orders VALUES (8, 'tyrell', 8.00, 'open');

statement ok
INSERT INTO s.orders VALUES (80, 'scenario-tyrell', 8.00, 'open');

query T
SELECT table_type FROM information_schema.tables WHERE table_catalog = 's' AND table_name = 'orders';
----
BASE TABLE

statement ok
COMMIT;

query I
SELECT count(*) FROM s.orders WHERE order_id IN (8, 80);
----
2

# materialized scenarios enumerate their frozen copies as base tables too
statement ok
CALL scenario_create('snap', mode := 'materialized');

statement ok
ATTACH 'snap' AS m (TYPE scenario);

query TT
SELECT table_name, table_type FROM information_schema.tables WHERE table_catalog = 'm' ORDER BY table_name;
----
order_audit	BASE TABLE
orders	BASE TABLE

statement ok
BEGIN;

statement ok
UPDATE m.orders SET amount = 1 WHERE order_id = 8;

statement ok
INSERT INTO order_audit VALUES (4, 8, 'note', 'host + materialized scenario');

statement ok
COMMIT;

query R
SELECT amount FROM m.orders WHERE order_id = 8;
----
1.00

statement ok
DETACH m;

statement ok
CALL scenario_drop('snap');

# --- generated variant: 100k host rows + 100k scenario rows in one transaction --

statement ok
CREATE TABLE big_orders (order_id BIGINT PRIMARY KEY, customer VARCHAR, amount DOUBLE);

statement ok
CREATE TABLE big_audit (audit_id BIGINT PRIMARY KEY, order_id BIGINT, action VARCHAR);

statement ok
INSERT INTO big_orders SELECT i, 'c' || (i % 97), (i % 1000) / 10.0 FROM range(100000) t(i);

statement ok
CALL scenario_create('bulk');

statement ok
ATTACH 'bulk' AS b (TYPE scenario);

statement ok
BEGIN;

statement ok
INSERT INTO big_orders SELECT i, 'new' || (i % 13), 1.0 FROM range(100000, 200000) t(i);

statement ok
UPDATE b.big_orders SET amount = amount * 2 WHERE order_id % 2 = 0;

statement ok
INSERT INTO b.big_audit SELECT i, i, 'scenario-bulk' FROM range(100000) t(i);

statement ok
INSERT INTO big_audit SELECT i, i, 'host-bulk' FROM range(100000, 150000) t(i);

statement ok
COMMIT;

query II
SELECT count(*), sum(amount)::BIGINT FROM big_orders;
----
200000	5095000

query II
SELECT count(*), sum(amount)::BIGINT FROM b.big_orders;
----
200000	7640000

query II
SELECT count(*) FILTER (WHERE action = 'host-bulk'), count(*) FILTER (WHERE action = 'scenario-bulk') FROM big_audit;
----
50000	0

query II
SELECT count(*) FILTER (WHERE action = 'host-bulk'), count(*) FILTER (WHERE action = 'scenario-bulk') FROM b.big_audit;
----
50000	100000

# rollback of a bulk mixed transaction leaves both sides untouched
statement ok
BEGIN;

statement ok
DELETE FROM big_orders WHERE order_id >= 100000;

statement ok
DELETE FROM b.big_orders WHERE order_id < 50000;

statement ok
ROLLBACK;

query II
SELECT (SELECT count(*) FROM big_orders), (SELECT count(*) FROM b.big_orders);
----
200000	200000

# --- cleanup --------------------------------------------------------------------

statement ok
DETACH b;

statement ok
DETACH p;

statement ok
DETACH s;

statement ok
CALL scenario_drop('bulk');

statement ok
CALL scenario_drop('pessimistic');

statement ok
CALL scenario_drop('whatif');

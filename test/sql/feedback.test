# name: test/sql/feedback.test
# description: The feedback banner's contracts: user errors carry no issue link,
#              and the banner never writes anything under a test runner.
# group: [anofox_scenario]

require anofox_scenario

# --- A user's own mistake (here: an unknown scenario name) is not a bug, so it
#     carries no "please report" issue link: only unexpected error types
#     (internal errors, plain std::exceptions) are annotated by the banner.
statement error
SELECT * FROM scenario_refresh('does_not_exist');
----
<!REGEX>:.*github.com/DataZooDE/anofox-scenario/issues.*

# The real diagnostic is reported unchanged.
statement error
SELECT * FROM scenario_refresh('does_not_exist');
----
Scenario 'does_not_exist' not found

# --- Errors DuckDB raises before dispatch (binder, catalog, arity) are
#     deliberately NOT annotated -- they are not ours, and claiming them would
#     send users to the wrong tracker.
statement error
SELECT * FROM scenario_refresh();
----
Binder Error

# --- The opt-out knob exists and is settable. The banner itself cannot be
#     observed from a .test file at all -- stderr is not a tty here, which is
#     precisely the guarantee that keeps this suite's expected output unchanged.
statement ok
SET datazoo_banner = false;

statement ok
SET datazoo_banner = true;

# name: test/sql/scenario_ducklake_keyless_merge.test
# description: merge-back of keyless (bag) tables into a DuckLake base: exact-multiplicity deletes, drift conflicts (#31)
# group: [anofox_scenario]

require anofox_scenario

require parquet

# needs the ducklake extension installed for the running duckdb version;
# run with DUCKLAKE_TESTS=1 (release build)
require-env DUCKLAKE_TESTS

statement ok
LOAD ducklake;

statement ok
ATTACH 'ducklake:__TEST_DIR__/lake_bag_meta.ducklake' AS lake (DATA_PATH '__TEST_DIR__/lake_bag_data');

# --- realistic keyless table with duplicate rows and NULLs ------------------------------

statement ok
CREATE TABLE lake.sensor_readings (device VARCHAR, reading_ts TIMESTAMP, value DOUBLE, unit VARCHAR);

statement ok
INSERT INTO lake.sensor_readings VALUES
    ('d1', TIMESTAMP '2026-01-01 00:00:00', 20.5, 'C'),
    ('d1', TIMESTAMP '2026-01-01 00:00:00', 20.5, 'C'),
    ('d1', TIMESTAMP '2026-01-01 00:00:00', 20.5, 'C'),
    ('d2', TIMESTAMP '2026-01-01 00:05:00', NULL, 'C'),
    ('d2', TIMESTAMP '2026-01-01 00:05:00', NULL, 'C'),
    (NULL, NULL, NULL, NULL),
    (NULL, NULL, NULL, NULL),
    ('d3', TIMESTAMP '2026-01-01 00:10:00', 7.0, 'bar'),
    ('d4', TIMESTAMP '2026-01-01 00:15:00', 1.0, 'C'),
    ('d4', TIMESTAMP '2026-01-01 00:15:00', 1.0, 'C');

statement ok
CALL scenario_create('sr', base := 'lake');

statement ok
ATTACH 'sr' AS sr (TYPE scenario);

# delete one of three duplicates: drop all copies, put two back (net -1)
statement ok
DELETE FROM sr.sensor_readings WHERE device = 'd1';

statement ok
INSERT INTO sr.sensor_readings VALUES
    ('d1', TIMESTAMP '2026-01-01 00:00:00', 20.5, 'C'),
    ('d1', TIMESTAMP '2026-01-01 00:00:00', 20.5, 'C');

# delete all copies of a row holding a NULL column (NULL-safe whole-row match)
statement ok
DELETE FROM sr.sensor_readings WHERE device = 'd2';

# all-NULL rows: delete both, insert one back (net -1)
statement ok
DELETE FROM sr.sensor_readings WHERE device IS NULL;

statement ok
INSERT INTO sr.sensor_readings VALUES (NULL, NULL, NULL, NULL);

# delete all copies
statement ok
DELETE FROM sr.sensor_readings WHERE device = 'd4';

# brand-new duplicated rows
statement ok
INSERT INTO sr.sensor_readings VALUES
    ('d5', TIMESTAMP '2026-01-01 00:20:00', 3.25, 'C'),
    ('d5', TIMESTAMP '2026-01-01 00:20:00', 3.25, 'C');

statement ok
CREATE TABLE expected_sr AS SELECT * FROM sr.sensor_readings;

query I
SELECT count(*) FROM expected_sr;
----
6

# no drift on the lake: nothing is flagged
query I
SELECT count(*) FROM scenario_merge_preview('sr') WHERE conflict;
----
0

query T
SELECT DISTINCT table_name FROM scenario_merge_preview('sr');
----
sensor_readings

statement ok
DETACH sr;

# 6 copies deleted (1 + 2 + 1 + 2), 2 copies inserted
query III
SELECT tables_changed, rows_applied, conflicts_resolved FROM scenario_merge('sr');
----
1	8	0

query TTRTI rowsort
SELECT device, reading_ts::VARCHAR, value, unit, count(*) FROM lake.sensor_readings GROUP BY ALL;
----
NULL	NULL	NULL	NULL	1
d1	2026-01-01 00:00:00	20.5	C	2
d3	2026-01-01 00:10:00	7.0	bar	1
d5	2026-01-01 00:20:00	3.25	C	2

# the lake now equals the scenario's merged view, as a multiset
query I
SELECT count(*) FROM (SELECT * FROM lake.sensor_readings EXCEPT ALL SELECT * FROM expected_sr);
----
0

query I
SELECT count(*) FROM (SELECT * FROM expected_sr EXCEPT ALL SELECT * FROM lake.sensor_readings);
----
0

query TT
SELECT frozen::VARCHAR, (merged_at IS NOT NULL)::VARCHAR FROM __anofox_scenario.registry WHERE name = 'sr';
----
true	true

statement ok
CALL scenario_drop('sr');

# --- drift: the lake's copies of a deleted row changed since the snapshot ---------------

statement ok
CREATE TABLE lake.events (src VARCHAR, code INTEGER);

statement ok
INSERT INTO lake.events VALUES ('a', 1), ('a', 1), ('a', 1), ('b', 2), ('b', 2), ('c', 3);

# two sibling scenarios with the same change, both pinned before the drift
statement ok
CALL scenario_create('ev_theirs', base := 'lake');

statement ok
CALL scenario_create('ev_ours', base := 'lake');

statement ok
ATTACH 'ev_theirs' AS et (TYPE scenario);

statement ok
ATTACH 'ev_ours' AS eo (TYPE scenario);

# ('a', 1): 3 -> 1 copies (net -2); ('c', 3): 1 -> 0 (net -1)
statement ok
DELETE FROM et.events WHERE src IN ('a', 'c');

statement ok
INSERT INTO et.events VALUES ('a', 1);

statement ok
DELETE FROM eo.events WHERE src IN ('a', 'c');

statement ok
INSERT INTO eo.events VALUES ('a', 1);

statement ok
DETACH et;

statement ok
DETACH eo;

# lake churn after the snapshots: one copy of ('a', 1) goes away, a copy of
# the untouched ('b', 2) is added
statement ok
DELETE FROM lake.events WHERE rowid = (SELECT min(rowid) FROM lake.events WHERE src = 'a');

statement ok
INSERT INTO lake.events VALUES ('b', 2);

# only the deletes of the drifted value conflict (preview rows are delta rows)
query TT rowsort
SELECT DISTINCT action, conflict::VARCHAR FROM scenario_merge_preview('ev_theirs') WHERE action = 'delete';
----
delete	false
delete	true

statement error
SELECT * FROM scenario_merge('ev_theirs');
----
<REGEX>:.*base changed underneath.*events.*

# the refused merge left the lake untouched
query TII rowsort
SELECT src, code, count(*) FROM lake.events GROUP BY ALL;
----
a	1	2
b	2	3
c	3	1

# theirs: the drifted value keeps the lake's copies, the clean delete applies
query III
SELECT tables_changed, rows_applied, conflicts_resolved FROM scenario_merge('ev_theirs', on_conflict := 'theirs');
----
1	1	1

query TII rowsort
SELECT src, code, count(*) FROM lake.events GROUP BY ALL;
----
a	1	2
b	2	3

# ours: the scenario's count wins - ('a', 1) ends at 1 copy; ('c', 3) is
# already gone (fewer copies left than to delete), which also conflicts
query T
SELECT DISTINCT conflict::VARCHAR FROM scenario_merge_preview('ev_ours') WHERE action = 'delete';
----
true

statement error
SELECT * FROM scenario_merge('ev_ours');
----
<REGEX>:.*base changed underneath.*events.*

query III
SELECT tables_changed, rows_applied, conflicts_resolved FROM scenario_merge('ev_ours', on_conflict := 'ours');
----
1	1	2

query TII rowsort
SELECT src, code, count(*) FROM lake.events GROUP BY ALL;
----
a	1	1
b	2	3

statement ok
CALL scenario_drop('ev_theirs');

statement ok
CALL scenario_drop('ev_ours');

# --- ours restores copies the lake lost: the scenario's count wins upward too -----------

statement ok
CREATE TABLE lake.tags (tag VARCHAR);

statement ok
INSERT INTO lake.tags VALUES ('x'), ('x'), ('x'), ('x');

statement ok
CALL scenario_create('tg', base := 'lake');

statement ok
ATTACH 'tg' AS tg (TYPE scenario);

# 4 -> 3 copies
statement ok
DELETE FROM tg.tags;

statement ok
INSERT INTO tg.tags VALUES ('x'), ('x'), ('x');

statement ok
DETACH tg;

# the lake drops to 1 copy meanwhile
statement ok
DELETE FROM lake.tags WHERE rowid IN (SELECT rowid FROM lake.tags ORDER BY rowid LIMIT 3);

query III
SELECT tables_changed, rows_applied, conflicts_resolved FROM scenario_merge('tg', on_conflict := 'ours');
----
1	2	1

query I
SELECT count(*) FROM lake.tags WHERE tag = 'x';
----
3

statement ok
CALL scenario_drop('tg');

# --- large generated variant: 120k rows with heavy duplication and NULLs ----------------

statement ok
CREATE TABLE lake.big (g INTEGER, payload VARCHAR, v DOUBLE);

statement ok
INSERT INTO lake.big
SELECT i % 1000, 'p' || (i % 37), CASE WHEN i % 11 = 0 THEN NULL ELSE (i % 5)::DOUBLE END
FROM range(120000) t(i);

statement ok
CALL scenario_create('bg', base := 'lake');

statement ok
ATTACH 'bg' AS bg (TYPE scenario);

# drop every row of 100 groups (~12k rows)
statement ok
DELETE FROM bg.big WHERE g < 100;

# put part of them back (partial deletes of duplicated values)
statement ok
INSERT INTO bg.big
SELECT i % 50, 'p' || (i % 37), CASE WHEN i % 11 = 0 THEN NULL ELSE (i % 5)::DOUBLE END
FROM range(3000) t(i);

# delete all-but-NULL rows of another band and add brand-new rows
statement ok
DELETE FROM bg.big WHERE g BETWEEN 500 AND 549 AND v IS NOT NULL;

statement ok
INSERT INTO bg.big
SELECT 1000 + i % 200, 'n' || (i % 3), NULL FROM range(10000) t(i);

statement ok
CREATE TABLE expected_bg AS SELECT * FROM bg.big;

statement ok
DETACH bg;

query I
SELECT count(*) FROM scenario_merge_preview('bg') WHERE conflict;
----
0

query I
SELECT conflicts_resolved FROM scenario_merge('bg');
----
0

query I
SELECT (SELECT count(*) FROM lake.big) = (SELECT count(*) FROM expected_bg);
----
true

query I
SELECT count(*) FROM (SELECT * FROM lake.big EXCEPT ALL SELECT * FROM expected_bg);
----
0

query I
SELECT count(*) FROM (SELECT * FROM expected_bg EXCEPT ALL SELECT * FROM lake.big);
----
0

statement ok
CALL scenario_drop('bg');

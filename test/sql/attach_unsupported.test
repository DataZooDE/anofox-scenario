# name: test/sql/attach_unsupported.test
# description: Phase 1: deliberately unsupported DML shapes fail with guidance (retired in v0.4/v0.5)
# group: [anofox_scenario]

require anofox_scenario

statement ok
CREATE TABLE forecast (id INTEGER PRIMARY KEY, qty INTEGER);

statement ok
INSERT INTO forecast VALUES (1, 100), (2, 200);

statement ok
CALL scenario_create('u');

statement ok
ATTACH 'u' AS s (TYPE scenario);

# DELETE ... RETURNING is supported since v0.4.1 (see attach_returning.test)
query II
DELETE FROM s.forecast WHERE id = 1 RETURNING id, qty;
----
1	100

statement ok
INSERT INTO s.forecast VALUES (1, 100);

# RETURNING on MERGE is supported since v0.4.1 (see attach_merge.test)
query ITT
MERGE INTO s.forecast USING (SELECT 1 AS id, 1 AS qty) src ON s.forecast.id = src.id WHEN MATCHED THEN UPDATE SET qty = src.qty RETURNING id, qty, merge_action;
----
1	1	UPDATE

# the table is still writable through the supported surface
statement ok
INSERT INTO s.forecast VALUES (5, 500);

query I
SELECT count(*) FROM s.forecast;
----
3

# --- a keyless table created in the base after the scenario (#39, #34) ----------
# It has no delta yet. Since #34 that is no error: the first write creates a
# bag delta, for every kind of DML (this section used to pin the #39 error).

statement ok
CREATE TABLE late_events (sku VARCHAR, qty INTEGER);

statement ok
INSERT INTO late_events VALUES ('A1', 1), ('B2', 2);

query TI
SELECT * FROM s.late_events ORDER BY sku;
----
A1	1
B2	2

statement ok
INSERT INTO s.late_events VALUES ('C3', 3);

statement ok
UPDATE s.late_events SET qty = 9 WHERE sku = 'A1';

statement ok
DELETE FROM s.late_events WHERE sku = 'B2';

statement ok
MERGE INTO s.late_events t USING (SELECT 'C3' AS sku) v ON t.sku = v.sku WHEN MATCHED THEN DELETE;

query TI
SELECT * FROM s.late_events ORDER BY sku;
----
A1	9

# the base is untouched, and the writes survive a re-attach
statement ok
DETACH s;

statement ok
ATTACH 'u' AS s (TYPE scenario);

query TI
SELECT * FROM s.late_events ORDER BY sku;
----
A1	9

query TI
SELECT * FROM late_events ORDER BY sku;
----
A1	1
B2	2

statement ok
DETACH s;

statement ok
CALL scenario_drop('u');

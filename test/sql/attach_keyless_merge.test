statement ok
DETACH m;

# =============================================================================
# 4. large generated variant: 120k keyless rows, every row present 3 times
# =============================================================================

statement ok
CREATE TABLE stock_moves AS
SELECT 'S' || (i % 40000) AS sku, 'W' || (i % 4) AS warehouse, (i % 100)::INTEGER AS qty,
       CASE WHEN i % 40000 % 11 = 0 THEN NULL ELSE 'n' || (i % 5) END AS note
FROM range(120000) t(i);

statement ok
CREATE TABLE oracle.stock_moves AS SELECT * FROM stock_moves;

# 30k distinct (sku, warehouse) sources: half match (3 copies each), half are new
statement ok
CREATE TABLE stock_adj AS
SELECT 'S' || (j * 2) AS sku, 'W' || (j * 2 % 4) AS warehouse, (j % 13)::INTEGER AS dq,
       CASE WHEN j % 10 = 0 THEN 'drop' ELSE 'add' END AS action
FROM range(30000) t(j);

statement ok
CALL scenario_create('big');

statement ok
ATTACH 'big' AS b (TYPE scenario);

statement ok
UPDATE b.stock_moves SET qty = qty + 1000 WHERE sku LIKE 'S1%';

statement ok
UPDATE oracle.stock_moves SET qty = qty + 1000 WHERE sku LIKE 'S1%';

query I
MERGE INTO b.stock_moves t USING stock_adj a
    ON t.sku = a.sku AND t.warehouse = a.warehouse
    WHEN MATCHED AND a.action = 'drop' THEN DELETE
    WHEN MATCHED THEN UPDATE SET qty = t.qty + a.dq, note = 'adj'
    WHEN NOT MATCHED THEN INSERT VALUES (a.sku, a.warehouse, a.dq, 'adj-new');
----
70000

query I
MERGE INTO oracle.stock_moves t USING stock_adj a
    ON t.sku = a.sku AND t.warehouse = a.warehouse
    WHEN MATCHED AND a.action = 'drop' THEN DELETE
    WHEN MATCHED THEN UPDATE SET qty = t.qty + a.dq, note = 'adj'
    WHEN NOT MATCHED THEN INSERT VALUES (a.sku, a.warehouse, a.dq, 'adj-new');
----
70000

query I
SELECT count(*) FROM b.stock_moves;
----
124000

query I
SELECT count(*) FROM (SELECT * FROM b.stock_moves EXCEPT ALL SELECT * FROM oracle.stock_moves);
----
0

query I
SELECT count(*) FROM (SELECT * FROM oracle.stock_moves EXCEPT ALL SELECT * FROM b.stock_moves);
----
0

statement ok
SELECT * FROM scenario_merge('big');

query I
SELECT count(*) FROM (SELECT * FROM stock_moves EXCEPT ALL SELECT * FROM oracle.stock_moves);
----
0

query I
SELECT count(*) FROM (SELECT * FROM oracle.stock_moves EXCEPT ALL SELECT * FROM stock_moves);
----
0

# large keyless upsert: 100k customers, 50k incoming with half conflicting
statement ok
CREATE TABLE bulk_emails (email VARCHAR UNIQUE, name VARCHAR, visits INTEGER);

statement ok
INSERT INTO bulk_emails
SELECT CASE WHEN i % 1000 = 0 THEN NULL ELSE 'u' || i || '@corp.com' END AS email, 'user ' || i AS name,
       (i % 7)::INTEGER AS visits
FROM range(100000) t(i);

statement ok
CREATE TABLE oracle.bulk_emails (email VARCHAR UNIQUE, name VARCHAR, visits INTEGER);

statement ok
INSERT INTO oracle.bulk_emails SELECT * FROM bulk_emails;

statement ok
CREATE TABLE incoming AS
SELECT 'u' || (i * 3) || '@corp.com' AS email, 'renamed ' || i AS name, 1 AS visits FROM range(50000) t(i);

statement ok
CALL scenario_create('bulk');

statement ok
ATTACH 'bulk' AS u (TYPE scenario);

statement ok
INSERT INTO u.bulk_emails SELECT * FROM incoming
    ON CONFLICT (email) DO UPDATE SET name = excluded.name, visits = bulk_emails.visits + excluded.visits;

statement ok
INSERT INTO oracle.bulk_emails SELECT * FROM incoming
    ON CONFLICT (email) DO UPDATE SET name = excluded.name, visits = bulk_emails.visits + excluded.visits;

query I
SELECT count(*) FROM (SELECT * FROM u.bulk_emails EXCEPT ALL SELECT * FROM oracle.bulk_emails);
----
0

query I
SELECT count(*) FROM (SELECT * FROM oracle.bulk_emails EXCEPT ALL SELECT * FROM u.bulk_emails);
----
0

statement ok
SELECT * FROM scenario_merge('bulk');

query I
SELECT count(*) FROM (SELECT * FROM bulk_emails EXCEPT ALL SELECT * FROM oracle.bulk_emails);
----
0

query I
SELECT count(*) FROM (SELECT * FROM oracle.bulk_emails EXCEPT ALL SELECT * FROM bulk_emails);
----
0
